# Copy this file to .env and fill in real values. Never commit .env.
# In production (NODE_ENV=production) the server refuses to start if a REQUIRED value is missing
# and prints exactly which one. Values marked "production: required" must be set there.

# ---- Server ----------------------------------------------------------------------------------
PORT=4242

# Leave empty (recommended): the site is in prelaunch while no mentor is listed and goes live by itself when the first
# mentor is listed. Or force "prelaunch" or "live". In prelaunch, mentors can sign up, apply and be verified and visitors
# can join the waiting list, but nobody can pay yet. A warning is printed if you force "live" with no mentor listed.
LAUNCH_MODE=

# "production" when deployed. Turns on the strict checks below and hides every development helper
# (codes/links shown on screen, the fake test bank). Leave empty for local development.
NODE_ENV=

# The public address of your site, exactly as visitors type it, with https:// and no trailing slash.
# Used for canonical links, share tags, sitemap.xml, robots.txt, emailed links and the bank's return
# and callback URLs. Production: required, must be https and must not be localhost.
PUBLIC_URL=http://localhost:4242

# ---- Database --------------------------------------------------------------------------------
# PostgreSQL connection string. Production: required. Hosted databases usually need ?sslmode=require
# on the end unless you use the provider's internal URL.
DATABASE_URL=postgresql://postgres:password@localhost:5432/wisecall
# A separate database used only by `npm test`. It is WIPED on every run. Never point it at real data.
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/wisecall_test

# ---- Secrets ---------------------------------------------------------------------------------
# Random string, 24+ characters, that signs login sessions. Production: required.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# (The old name JWT_SECRET still works.)
SESSION_SECRET=
# Random string, 32+ characters, that encrypts mentors' IBANs in the database. Production: required.
# Keep a safe copy: if it is lost or changed, stored IBANs can no longer be read.
DATA_ENCRYPTION_KEY=

# ---- Money -----------------------------------------------------------------------------------
# Wisecall's cut of each paid question, as a percent. 20 = Wisecall keeps 20%, the mentor gets 80%.
# The bank also charges its own card fee on every payment, so very low values can lose money.
PLATFORM_FEE_PERCENT=20
# Days a mentor has to answer before the question is refunded automatically. (Also written in the Terms.)
ANSWER_DEADLINE_DAYS=7
# A mentor's earnings become payable this many days after the answer (the buyer's refund window).
PAYOUT_HOLD_DAYS=7
# How often (seconds) the background job checks for overdue questions, missed payments and refunds.
SWEEP_INTERVAL_SECONDS=600

# ---- Card payments through a Georgian bank (GEL) ----------------------------------------------
# Which bank takes the money: bog (Bank of Georgia), tbc (TBC Bank), or mock (a FAKE bank page for
# local development only, refused in production). Production: required, bog or tbc.
PAYMENT_PROVIDER=mock
# How long a buyer has to finish paying on the bank's page, in minutes.
PAYMENT_TTL_MINUTES=30

# Bank of Georgia (https://api.bog.ge/docs/en/). Production with bog: BOG_CLIENT_ID and BOG_CLIENT_SECRET required.
BOG_CLIENT_ID=
BOG_CLIENT_SECRET=
# Only change these two if BOG gives you different (for example sandbox) addresses.
BOG_API_URL=https://api.bog.ge
BOG_AUTH_URL=https://oauth2.bog.ge/auth/realms/bog/protocol/openid-connect/token
# Leave empty to use the public key BOG publishes for signing callbacks.
BOG_CALLBACK_PUBLIC_KEY=

# TBC Bank tpay (https://developers.tbcbank.ge). Production with tbc: all three keys required.
TBC_API_KEY=
TBC_CLIENT_ID=
TBC_CLIENT_SECRET=
TBC_API_URL=https://api.tbcbank.ge

# ---- ID verification for mentors (KYC) ---------------------------------------------------------
# Which provider checks a mentor's ID card or passport and takes a selfie: didit, or mock (a FAKE
# check for local development only, refused in production). Production: required, didit.
KYC_PROVIDER=mock
# Didit (https://didit.me). Production: all three required.
#   1. Create an account and an application at https://business.didit.me
#   2. Create a workflow with ID verification + liveness + face match, and copy its id
#   3. Add a webhook to  https://YOUR-PUBLIC-URL/api/kyc/webhook  and copy its signing secret
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
# Only change if Didit gives you a different address.
DIDIT_API_URL=https://verification.didit.me

# ---- Email (verification codes, password resets, notifications) --------------------------------
# Provider: resend (default), postmark, or log (writes emails to EMAIL_LOG_FILE, for tests only).
EMAIL_PROVIDER=resend
# Production with resend: RESEND_API_KEY required (https://resend.com).
RESEND_API_KEY=
# Production with postmark: POSTMARK_TOKEN required.
POSTMARK_TOKEN=
# The sender. Production: required, on a domain you verified with the email provider.
EMAIL_FROM=Wisecall <onboarding@resend.dev>
# The PUBLIC contact address (for example support@yourdomain.com). It is shown in the footer, the contact page,
# the Terms and the Privacy Policy, and is the Reply-To of every email. Use a role address, not a personal one.
# Contact-form messages do NOT go here: they go to ADMIN_EMAILS, which stays private.
SUPPORT_EMAIL=
# Only used when EMAIL_PROVIDER=log.
EMAIL_LOG_FILE=
# Optional. Only change these two to point at a test double.
RESEND_API_URL=https://api.resend.com/emails
POSTMARK_API_URL=https://api.postmarkapp.com

# ---- Footer: social links --------------------------------------------------------------------
# Optional. Full https:// addresses of your pages. Any that is empty is simply not shown in the footer.
# (SUPPORT_EMAIL above is the contact address shown in the footer.)
SOCIAL_FACEBOOK=
SOCIAL_INSTAGRAM=
SOCIAL_LINKEDIN=
SOCIAL_X=
SOCIAL_TIKTOK=
SOCIAL_YOUTUBE=

# ---- Admins ----------------------------------------------------------------------------------
# Comma-separated emails allowed to use /admin.html (approve mentors, refund bookings, record
# payouts). Production: required. (The single-address name ADMIN_EMAIL also works.)
ADMIN_EMAILS=
ADMIN_EMAIL=
