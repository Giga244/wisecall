# Copy this file to .env and fill in real values. Never commit .env.
# In production (NODE_ENV=production) the server refuses to start if a REQUIRED value is missing
# and prints exactly which one. Values marked "production: required" must be set there. The bank and
# ID-check (Didit) values are needed only for LAUNCH_MODE=live: with LAUNCH_MODE=prelaunch the site can go
# online without them (nothing can be booked or paid, mentors see "ID checks open soon").

# ---- Server ----------------------------------------------------------------------------------
PORT=4242

# prelaunch: the first deploy, BEFORE you have the bank and Didit keys. Mentors can sign up and apply, visitors can join the
#   waiting list, nobody can book or pay, and the ID-check step says "ID checks open soon". The server starts without any
#   PAYMENT_PROVIDER / bank / Didit value.
# live: the site is open to buyers. The server then REFUSES to start without the real bank keys and the Didit keys.
# empty (automatic): prelaunch until the bank keys and the Didit keys are set AND the first mentor is listed, then live by itself
#   (it never opens without them). A warning is printed if you force "live" with no mentor listed.
LAUNCH_MODE=

# "production" when deployed. Turns on the strict checks below and hides every development helper
# (codes/links shown on screen, the fake test bank). Leave empty for local development.
NODE_ENV=

# The public address of your site, exactly as visitors type it, with https:// and no trailing slash.
# Used for canonical links, share tags, sitemap.xml, robots.txt, emailed links and the bank's return
# and callback URLs. Production: required, must be https and must not be localhost. Production value: https://wisecall.ge
PUBLIC_URL=http://localhost:4242
# After a move to another domain (docs/DOMAIN-MOVE.md): the site's earlier host name(s), comma-separated, for example
# old-site.ge,www.old-site.ge. A request for one of them is sent to the same page on PUBLIC_URL with a permanent 301 (the addresses
# outside services call still answer there). Empty = no redirect at all.
OLD_DOMAINS=

# ---- Database --------------------------------------------------------------------------------
# PostgreSQL connection string. Production: required. Hosted databases usually need ?sslmode=require
# on the end unless you use the provider's internal URL.
DATABASE_URL=
# A separate database used only by `npm test`. It is WIPED on every run. Never point it at real data.
TEST_DATABASE_URL=

# ---- Secrets ---------------------------------------------------------------------------------
# Random string, 24+ characters, that signs login sessions. Production: required.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# (The old name JWT_SECRET still works.)
SESSION_SECRET=
# Random string, 32+ characters, that encrypts mentors' IBANs in the database. Production: required.
# Keep a safe copy: if it is lost or changed, stored IBANs can no longer be read.
DATA_ENCRYPTION_KEY=

# ---- Money -----------------------------------------------------------------------------------
# Wisecall's cut of each paid question, as a percent. 20 = Wisecall keeps 20%, the mentor gets 80%.
# The bank also charges its own card fee on every payment, so very low values can lose money.
PLATFORM_FEE_PERCENT=20
# Days a mentor has to answer before the question is refunded automatically. (Also written in the Terms.)
ANSWER_DEADLINE_DAYS=7
# A mentor's earnings become payable this many days after the answer (the buyer's refund window).
PAYOUT_HOLD_DAYS=7
# A change of a mentor's payout details holds their payouts this many hours (and emails them). Accounts without a password (Google)
# must have signed in within REAUTH_MINUTES to change payout details.
PAYOUT_CHANGE_HOLD_HOURS=72
REAUTH_MINUTES=10
# Per account: questions started per hour, and unpaid attempts open at once (0 = no limit).
BOOKINGS_PER_HOUR=10
MAX_OPEN_UNPAID_BOOKINGS=3
# The asker can report a problem with an answer this many days after they can read it (earnings are held at least this long too).
DISPUTE_DAYS=7
# What a mentor is promised after submitting an application: "we review applications within N working days".
MENTOR_REVIEW_DAYS=2
# New passwords are checked against known data breaches (Have I Been Pwned; only 5 characters of the password's SHA-1 hash are sent).
# On in production unless set to off; off on your own computer unless set to on.
HIBP_CHECK=
# How often (seconds) the background job checks for overdue questions, missed payments and refunds.
SWEEP_INTERVAL_SECONDS=600
# Withdrawals: the smallest amount a mentor can withdraw (lari), the bank transfer fee taken from it (percent), and how the money is sent
# (manual = an admin makes the bank transfer and records it; flitt_iban = an admin sends it through Flitt with a 2FA code).
PAYOUT_MIN_GEL=100
BANK_FEE_PERCENT=2
PAYOUT_METHOD=manual
# Sign-in protection: this many wrong passwords for one email within the window (minutes) pause signing in to it for LOGIN_LOCK_MINUTES,
# and the account owner is emailed.
LOGIN_LOCK_FAILURES=10
LOGIN_LOCK_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=5
# Cloudflare Turnstile, the "are you a person?" check on sign-up, login, forgot password, contact, the waiting list and mentor requests.
# Both keys from the Cloudflare dashboard (Turnstile, add the site). Empty = off (rate limits only). Never commit the secret key.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Live sessions on or off for everybody. Empty = off in production (no page, link, text, email or API of them for users; admins see a
# read-only Live tab) and on elsewhere. LIVE_SESSIONS=on turns them on; nothing else needs to change.
LIVE_SESSIONS=
# Live sessions (paid live video sessions hosted by mentors). The video service: daily (https://www.daily.co, create an account and an API
# key in the Daily dashboard: Developers -> API keys) or empty (live sessions cannot be published). "fake" is for development only.
LIVE_PROVIDER=
DAILY_API_KEY=
# The most people in one session (a Small circle is always at most 8), how long a seat is held while someone pays, and how far ahead
# a session must be published.
LIVE_MAX_PARTICIPANTS=30
LIVE_HOLD_MINUTES=15
LIVE_MIN_LEAD_HOURS=24
# Series (several sessions in one payment; a cancelled session is refunded as a partial refund of that payment). Off in production
# until the bank confirms several partial refunds per payment are allowed: LIVE_SERIES=on turns it on.
LIVE_SERIES=

# ---- Card payments through a Georgian bank (GEL) ----------------------------------------------
# Which bank takes the money: flitt (the chosen provider), bog (Bank of Georgia), tbc (TBC Bank), or mock (a FAKE bank page for
# local development only, refused in production). Required only for LAUNCH_MODE=live (leave it out in prelaunch).
PAYMENT_PROVIDER=mock
# How long a buyer has to finish paying on the bank's page, in minutes.
PAYMENT_TTL_MINUTES=30

# Flitt (flitt.com, the chosen provider: PAYMENT_PROVIDER=flitt). From the Flitt merchant portal; never commit them.
FLITT_MERCHANT_ID=
FLITT_SECRET_KEY=
# The payout (credit) key, for PAYOUT_METHOD=flitt_iban (IBAN withdrawals to mentors, sent by an admin with a 2FA code).
FLITT_PAYOUT_SECRET_KEY=
# Flitt's callback addresses (default: 54.154.216.60,3.75.125.89). Empty = any address (the signature and the status check still apply).
# FLITT_CALLBACK_IPS=
# At most this much is sent to mentors through Flitt in one day (PAYOUT_METHOD=flitt_iban, set above).
PAYOUT_DAILY_LIMIT_GEL=3000
# Bank of Georgia (https://api.bog.ge/docs/en/). With bog and LAUNCH_MODE=live: BOG_CLIENT_ID and BOG_CLIENT_SECRET required.
BOG_CLIENT_ID=
BOG_CLIENT_SECRET=
# Only change these two if BOG gives you different (for example sandbox) addresses.
BOG_API_URL=https://api.bog.ge
BOG_AUTH_URL=https://oauth2.bog.ge/auth/realms/bog/protocol/openid-connect/token
# Leave empty to use the public key BOG publishes for signing callbacks.
BOG_CALLBACK_PUBLIC_KEY=

# TBC Bank tpay (https://developers.tbcbank.ge). With tbc and LAUNCH_MODE=live: all three keys required.
TBC_API_KEY=
TBC_CLIENT_ID=
TBC_CLIENT_SECRET=
TBC_API_URL=https://api.tbcbank.ge
# [CONFIRM WITH BANK] The longest payment window TBC accepts (their example uses 12 minutes) and the spelling of the sub-total field.
TBC_MAX_EXPIRATION_MINUTES=12
TBC_SUBTOTAL_FIELD=subTotal

# ---- ID verification for mentors (KYC) ---------------------------------------------------------
# Which provider checks a mentor's ID card or passport and takes a selfie: didit, or mock (a FAKE
# check for local development only, refused in production). Required, didit, only for LAUNCH_MODE=live (leave it out in prelaunch).
KYC_PROVIDER=mock
# Didit (https://didit.me). With LAUNCH_MODE=live: all three required.
#   1. Create an account and an application at https://business.didit.me
#   2. Create a workflow with ID verification + liveness + face match, and copy its id
#   3. Add a webhook to  https://YOUR-PUBLIC-URL/api/kyc/webhook  and copy its signing secret
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
# Only change if Didit gives you a different address.
DIDIT_API_URL=https://verification.didit.me

# ---- Mentor verification: automatic review (rules v2) -----------------------------------------
# A mentor applies in three steps (Identity -> Experience -> Review). When they submit, the server checks their evidence links and,
# with a key below, asks an AI model (Claude, by Anthropic) to score the application and write a summary for the admin. The AI only
# advises; the rules in server/verification/rules.js decide, and a person makes every rejection.
# The key from https://console.anthropic.com (Settings > API keys). Empty = the AI part is skipped and every application goes to a person.
ANTHROPIC_API_KEY=
# The model. Default: claude-sonnet-5 (about 2 US cents per application). Change it here to switch later.
# ANTHROPIC_MODEL=claude-sonnet-5
# Asked once more when the first model declines to answer for safety reasons. Empty = no second try.
# ANTHROPIC_FALLBACK_MODEL=claude-opus-5
# low | medium | high: how much the model thinks (lower is cheaper and faster). Default: medium.
# ANTHROPIC_EFFORT=medium
# Spending limits. Past the monthly budget (US dollars) the AI part is skipped until next month and applications go to a person with the
# link checks only (the admins are emailed once). Each mentor gets at most this many AI reviews a day.
# AI_MONTHLY_BUDGET_USD=20
# AI_REVIEWS_PER_MENTOR_PER_DAY=4
# on = the analysis may approve a mentor by itself when EVERY rule holds (never in a regulated field such as medicine, law or finance).
# off (the default) = a person approves every mentor, with the analysis to help.
AUTO_APPROVE=off
# Development only (refused in production): let the link checker open pages on this computer, and use a different domain-age service.
# LINK_CHECK_ALLOW_PRIVATE=
# RDAP_BASE_URL=

# ---- Sign in with Google (optional) -----------------------------------------------------------
# Both empty = no "Continue with Google" button. Both set = the button appears on the login and sign-up pages.
# Create them in Google Cloud Console (DEPLOY.md, step 2c): an OAuth client of type "Web application" whose
# authorised redirect URI is exactly  PUBLIC_URL + /api/auth/google/callback  (for example
# https://wisecall.ge/api/auth/google/callback, and http://localhost:4242/api/auth/google/callback on your own computer).
# The scopes are only: openid, email, profile. The client secret is a password: keep it out of chats and the code.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Email (verification codes, password resets, notifications) --------------------------------
# Provider: resend (default), postmark, or log (writes emails to EMAIL_LOG_FILE, for tests only).
EMAIL_PROVIDER=resend
# Production with resend: RESEND_API_KEY required (https://resend.com).
RESEND_API_KEY=
# Production with postmark: POSTMARK_TOKEN required.
POSTMARK_TOKEN=
# The sender. Production: required, on a domain you verified with the email provider. Production value:
#   EMAIL_FROM=Wisecall <hello@wisecall.ge>
# (Resend's onboarding@resend.dev below only delivers to the account owner: fine on your own computer, not online.)
EMAIL_FROM=Wisecall <onboarding@resend.dev>
# The PUBLIC contact address (for example support@yourdomain.com). It is shown in the footer, the contact page,
# the Terms and the Privacy Policy, and is the Reply-To of every email. Use a role address, not a personal one.
# Contact-form messages do NOT go here: they go to ADMIN_EMAILS, which stays private.
# Left empty, the server prints a warning at startup and `npm run check:launch` shows a warning. On your own computer use a
# placeholder such as support@wisecall.test; online use support@wisecall.ge.
SUPPORT_EMAIL=
# Only used when EMAIL_PROVIDER=log.
EMAIL_LOG_FILE=
# Optional. Only change these two to point at a test double.
RESEND_API_URL=https://api.resend.com/emails
POSTMARK_API_URL=https://api.postmarkapp.com

# ---- The seller's legal details ------------------------------------------------------------------
# Shown on receipts (and in the footer) as Georgian e-commerce rules expect: the company or individual entrepreneur, its
# identification number and legal address. Each is shown only when set.
LEGAL_NAME=
LEGAL_ID=
LEGAL_ADDRESS=

# ---- About page: the founder (hidden while FOUNDER_NAME is empty) -----------------------------------------------
# FOUNDER_PHOTO is a picture on this site, for example /brand/founder.jpg (put the file in public/brand/). Stories are plain text.
FOUNDER_NAME=
FOUNDER_ROLE=
FOUNDER_PHOTO=
FOUNDER_STORY_EN=
FOUNDER_STORY_KA=

# ---- Social links: the footer, the waiting list's thank-you, the welcome and "your answer has arrived" emails, sameAs ------------
# Full https:// addresses. Instagram, TikTok and Facebook default to Wisecall's own accounts while they are not set at all
# (the Instagram, TikTok and Facebook pages in server/config.js SOCIAL_DEFAULTS); set one to change
# it, or set it to an empty value to hide its icon. The others are shown only when set.
# (SUPPORT_EMAIL above is the contact address shown in the footer.)
# SOCIAL_INSTAGRAM=
# SOCIAL_TIKTOK=
# SOCIAL_FACEBOOK=
SOCIAL_LINKEDIN=
SOCIAL_X=
SOCIAL_YOUTUBE=

# ---- Admins ----------------------------------------------------------------------------------
# Comma-separated emails allowed to use /admin.html (approve mentors, refund bookings, record
# payouts). Production: required. (The single-address name ADMIN_EMAIL also works.)
ADMIN_EMAILS=
ADMIN_EMAIL=
# Admin accounts must pass two-step verification (an authenticator app + recovery codes) before any admin action: it is ON by default
# and cannot be switched off in production. On your own computer the set-up page shows the QR code, the key, and (development only) the code the
# app would show, so no phone is needed. "off" exists only for the automated tests (the server prints a warning; production refuses to start).
# ADMIN_2FA=required
# How long a verified admin session lasts before the code is asked for again (1 to 72 hours).
# ADMIN_2FA_SESSION_HOURS=12

# ---- Visitor statistics and error monitoring (both optional; nothing personal is sent) ----------------------------
# Plausible (https://plausible.io): the site's domain as added there, for example wisecall.ge. Empty = no statistics. No cookies,
# no script in the pages: the server reports page views and a few events (sign-up, mentor application, waiting list, question paid).
PLAUSIBLE_DOMAIN=
# Search engine verification (docs/CLAUDE-CODE-SEO.md): the code from Google Search Console ("HTML tag" method: the content="..." value of
# its google-site-verification tag) and from Bing Webmaster Tools (the content="..." value of its msvalidate.01 tag). Only the code, not
# the whole tag. When set, the home page carries the tag; empty = no tag.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Where visitors come from: a first-party cookie (wc_src, 30 days) with the campaign (utm_*) or the referring site of the first visit,
# counted per campaign in Admin -> Overview. Not set under Do Not Track / Global Privacy Control. "off" turns it off.
ATTRIBUTION_COOKIE=on
# Sentry (https://sentry.io): the project's DSN. Empty = off. Errors are sent without personal data (see server/errorReport.js).
SENTRY_DSN=
# Capacity (docs/TODO-REHEARSAL.md). All optional; the defaults suit one Render instance.
# Database connections (keep DB_POOL_MAX x instances below the database plan's limit).
DB_POOL_MAX=15
# How long visitors who are not signed in may be sent the same public lists (30 in production, 0 = off elsewhere).
PUBLIC_CACHE_SECONDS=
# How long each mentor's statistics are kept (60 in production, 0 elsewhere).
MENTOR_STATS_CACHE_SECONDS=
# When the host stops the server, open connections are closed after this many milliseconds at most.
SHUTDOWN_GRACE_MS=20000
