# Copy this file to .env and fill in real values. Never commit .env.

PORT=4242
# Public address of the site (used in emailed links and Stripe redirects). Must be https:// in production.
APP_URL=http://localhost:4242

# "production" when deployed. In production the server refuses to start if a required value
# below is missing, hides all dev-mode shortcuts (codes/links shown on screen), and requires
# STRIPE_WEBHOOK_SECRET when Stripe is enabled. Leave unset for local development.
NODE_ENV=

# PostgreSQL connection string (required). Hosted databases usually need ?sslmode=require
# on the end unless you use the provider's internal URL.
DATABASE_URL=postgresql://postgres:password@localhost:5432/wisecall
# Separate database used only by `npm test` (it is wiped on every run!). Never point this at real data.
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/wisecall_test

# Random string, 24+ characters, used to sign login sessions (required in production).
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Currency for charges (lowercase ISO code Stripe supports, e.g. usd, eur).
CURRENCY=usd

# Platform's cut of each paid question, as a percent. 20 = Wisecall keeps 20%, the mentor gets 80%.
# (Stripe also charges its own processing fee on top, so very low values can lose money.)
PLATFORM_FEE_PERCENT=20

# Days a mentor has to answer before the question is refunded automatically.
ANSWER_DEADLINE_DAYS=7

# Leave the Stripe values blank for local "simulated payment" mode.
# Test keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (verification codes, password resets, notifications) via https://resend.com
# Blank = local dev mode where codes/links are shown on screen instead of emailed.
# Required in production. EMAIL_FROM must be on a domain you verified with the provider.
RESEND_API_KEY=
EMAIL_FROM=Wisecall <onboarding@resend.dev>

# Comma-separated emails allowed to approve/reject mentors at /admin.html (required in production).
ADMIN_EMAILS=
