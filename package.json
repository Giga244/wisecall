{
  "name": "wisecall",
  "version": "1.0.0",
  "description": "Wisecall - paid advice marketplace (EN/KA)",
  "main": "server/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js tests/cloud/*.test.js tests/cloud-2/*.test.js",
    "migrate": "node scripts/migrate.js",
    "check:launch": "node scripts/check-launch.js",
    "admin:reset-2fa": "node scripts/reset-admin-2fa.js",
    "check:colors": "node scripts/check-colors.js",
    "check:contrast": "node scripts/check-contrast.js",
    "test:e2e": "playwright test && playwright test -c tests/e2e-cloud",
    "lighthouse": "node scripts/lighthouse.js",
    "backup": "node scripts/backup.js",
    "backup:check": "node scripts/backup.js check",
    "check:secrets": "node scripts/secret-scan.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "jose": "^6.2.12",
    "jsonwebtoken": "^9.0.2",
    "openid-client": "^6.8.8",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "tldts": "^7.4.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "lighthouse": "^13.5.0"
  }
}
